# Copiar a keystore.properties y completar con tus credenciales locales.
# keystore.properties está en .gitignore y no se sube al repositorio.
DPAY_RELEASE_STORE_FILE=dpay-release.keystore
DPAY_RELEASE_KEY_ALIAS=your-key-alias
DPAY_RELEASE_STORE_PASSWORD=your-store-password
DPAY_RELEASE_KEY_PASSWORD=your-key-password

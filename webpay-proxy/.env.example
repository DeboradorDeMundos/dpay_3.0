# Puerto del proxy (app Android emulador: http://10.0.2.2:8787)
PORT=8787
HOST=0.0.0.0

# URL pública del proxy (usada en redirect_url y return)
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Deep link de retorno a la app D-PAY
APP_RETURN_SCHEME=dtemitepos://payments/webpay/return

# Provider: sim | chimuelo
# sim = sandbox Capstone sin Transbank (recomendado para demo/QA)
# chimuelo = reenvía a Chimuelo/DTemite (requiere URL y token)
PROVIDER=sim

# Solo si PROVIDER=chimuelo
CHIMUELO_BASE_URL=https://chimuelo.dtemite.cl
CHIMUELO_TOKEN=
CHIMUELO_ENV=development

# Token opcional de API del proxy (si vacío, abierto en LAN — solo QA)
PROXY_API_TOKEN=

# Ruta SQLite
SQLITE_PATH=./data/webpay_payments.sqlite

# Puerto del proxy (app Android emulador: http://10.0.2.2:8787)
PORT=8787
HOST=0.0.0.0

# URL pública del proxy (usada en redirect_url y return)
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Deep link de retorno a la app D-PAY
APP_RETURN_SCHEME=dtemitepos://payments/webpay/return

# Provider: sim | webpayplus | chimuelo
# sim = sandbox Capstone sin Transbank (demo sin salir a internet)
# webpayplus = API REST de integración con códigos públicos (MVP)
# chimuelo = reenvía a Chimuelo/DTemite (requiere URL y token)
PROVIDER=sim

# Webpay Plus integración. Códigos públicos de Transbank Developers.
# No reemplazan el formulario de producción ni la llave secreta del comercio.
TBK_HOST=https://webpay3gint.transbank.cl
TBK_API_KEY_ID=597055555532
TBK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# Solo si PROVIDER=chimuelo
CHIMUELO_BASE_URL=https://chimuelo.dtemite.cl
CHIMUELO_TOKEN=
CHIMUELO_ENV=development

# Token opcional de API del proxy (si vacío, abierto en LAN — solo QA)
PROXY_API_TOKEN=

# Ruta SQLite
SQLITE_PATH=./data/webpay_payments.sqlite
